    section_casts();
    section_compile_time();
    section_asm();
    section_libc();
    section_conversions();
    section_lambda();
    section_operator_overload();
    section_storage();
    section_modules();
    section_declarations();
    section_p1p2_syntax();
    section_atomic_thread();
    section_compile_only();
    if (fails == 0) {
        println("ALL FEATURES OK");
    }
    return fails;
}
