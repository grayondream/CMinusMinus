(* =========================================================================
   Cmm 1.0 — 规范性文法（EBNF skeleton）
   对应 TODO: INF-06 / INF-09 / INF-10 / INF-11

   约定 / Notation
     - 终结符使用单引号：'if'、'+'、';'
     - { X }   重复 0 次或多次
     - [ X ]   可选
     - X | Y   择一
     - (* … *) 注释（非文法）
     - 优先级未在产生式中重复的二元运算符，统一见 §6.2 优先级/结合性表

   状态标记（置于产生式旁）
     [impl] 当前实现已支持（以 src/frontend 为准）
     [plan] TODO 规划，尚未实现
     [ng]   明确不做（Non-goals），列出仅为消歧

   本文件是规范的骨架：目标是完整覆盖语言；带 [plan] 的条目在实现前
   可能随对应 DEC 决策调整。
   ========================================================================= *)


(* =========================================================================
   §1 词法（Lexical，信息性；规范性以 INF-11 + LEX-* 为准）
   ========================================================================= *)

translation-unit    = { top-level-declaration } , EOF ;

(* --- 注释 --- *)
line-comment        = '//' , { any-char - newline } , newline ;
block-comment       = '/*' , { any-char } , '*/' ;                  (* 不嵌套 *)

(* --- 标识符 --- *)
identifier          = identifier-start , { identifier-continue } ;
identifier-start    = letter | '_' | unicode-letter ;
identifier-continue = letter | digit | '_' | unicode-letter | unicode-digit ;
(* [impl] LEX-18: UTF-8 多字节序列（高位字节）计入标识符；不做 NFC 规范化 *)

(* --- 整型字面量 LEX-04 / LEX-15 / LEX-17 --- *)
(* 分隔符 '_' 只能出现在两个数字之间；前导、结尾、连续、紧邻进制前缀均非法（E0004）。*)
integer-literal     = decimal-literal
                    | hex-literal
                    | binary-literal
                    | octal-literal ;
decimal-literal     = decimal-digits ;
decimal-digits      = decimal-digit , { [ '_' ] , decimal-digit } ;
hex-literal         = '0' , ( 'x' | 'X' ) , hex-digits ;
hex-digits          = hex-digit , { [ '_' ] , hex-digit } ;
binary-literal      = '0' , ( 'b' | 'B' ) , binary-digits ;
binary-digits       = binary-digit , { [ '_' ] , binary-digit } ;
octal-literal       = '0' , ( 'o' | 'O' ) , octal-digits ;
octal-digits        = octal-digit , { [ '_' ] , octal-digit } ;
integer-suffix      = [ 'u' | 'l' | 'll' | 'ul' | 'lu' | 'ull' | 'llu' ] ;
(* [impl] LEX-15 后缀 → 基础类型：无→int32；u→uint32；l/ll→int64；ul/lu/ull/llu→uint64
   （大小写不敏感；SG-18 起接受 C 的 LL/ULL 写法）*)

(* --- 浮点字面量 LEX-05 / TYP-04 --- *)
float-literal       = decimal-digits , '.' , [ decimal-digits ] , [ exponent ] , [ float-suffix ]
                    | decimal-digits , exponent , [ float-suffix ]
                    | '.' , decimal-digits , [ exponent ] , [ float-suffix ]   (* [impl] SG-18 *)
                    | hex-float-literal ;                                     (* [impl] SG-18 *)
exponent            = ( 'e' | 'E' ) , [ '+' | '-' ] , decimal-digits ;
hex-float-literal   = '0' , ( 'x' | 'X' ) , [ hex-digits ] , '.' , [ hex-digits ] ,
                      ( 'p' | 'P' ) , [ '+' | '-' ] , decimal-digits , [ float-suffix ]
                    | '0' , ( 'x' | 'X' ) , hex-digits ,
                      ( 'p' | 'P' ) , [ '+' | '-' ] , decimal-digits , [ float-suffix ] ;
float-suffix        = 'f' | 'f16' | 'f32' | 'f64' | 'f128' | 'l' ;
(* [impl] LEX-15 后缀 → 基础类型：无→float64；f/f32→float32；f64→float64；f16/f128→对应类型；l 为 float64 旧写法 *)
(* [impl] LEX-05 指数 e/E（可带 +/-，数字间允许 '_'）已实现；小数点后允许空尾数，
   即 `1.` / `1.e3` 这类“结尾点”形式已接受（LEX-05 收尾）。数字后紧跟 '.' 一律进入小数部分：
   `1.foo` 词法化为 FLOAT(`1.f`) + IDENT(`oo`)，与 `1.5.foo` 的既有切分同类。 *)

(* --- 字符/字符串字面量 LEX-06 / LEX-16 --- *)
char-literal        = [ ( 'u8' | 'u' | 'U' | 'L' ) ] ,
                      "'" , ( char-char | escape-sequence ) , "'" ;
                    (* [impl] SG-18 字符前缀；u8/u/U/L 均按单字符接受 *)
string-literal      = '"' , { string-char | escape-sequence } , '"'
                      (* [impl] SG-07: adjacent string literals concatenate *)
                    | 'r"' , { any-char - '"' } , '"'               (* [impl] 原始字符串 *)
                    | 'R"' , [ raw-delimiter ] , '(' , { any-char } , ')' ,
                      [ raw-delimiter ] , '"'                        (* [impl] SG-18 *)
                    | '"""' , { any-char } , '"""'                  (* [impl] 多行字符串 LEX-16 *)
                    | ( 'u8' | 'u' | 'u16' | 'u32' | 'U' | 'L' ) , '"' ,
                      { string-char | escape-sequence } , '"'
                                                                    (* [impl] TYP-05 / SG-18 前缀字面量 *)
                    | multiline-string ;
raw-delimiter       = raw-delim-char , { raw-delim-char } ;         (* 最长 16 字符 *)
raw-delim-char      = any-char - ( '(' | ')' | '\\' | '"' | whitespace ) ;
escape-sequence     = '\' , ( "'" | '"' | '\' | 'n' | 't' | 'r' | '0'
                            | 'a' | 'b' | 'f' | 'v' | '?'
                            | 'x' , hex-digit , hex-digit
                            | 'u' , '{' , hex-digit , { hex-digit } , '}' ) ;
(* [impl] LEX-16: 转义全集已实现（含 \a\b\f\v\? 与 \u{...}） *)

(* --- 布尔/空字面量 --- *)
boolean-literal     = 'true' | 'false' ;
null-literal        = 'null' ;                                      (* [impl] 唯一空指针拼写（Review 2.3） *)


(* =========================================================================
   §2 顶层声明 / 模块 / 命名空间（MOD / PAR-01 / PAR-22）
   ========================================================================= *)

top-level-declaration
    = { annotation } , ( module-decl | import-decl | export-decl
                       | namespace-decl | declaration ) ;

module-name         = identifier , { '.' , identifier } ;          (* [impl] MOD-04：module 只用点分路径 *)
module-decl         = 'module' , module-name , ';' ;
import-decl         = 'import' , ( module-name | string-literal ) , ';' ;  (* [impl] MOD-04/14 *)
(* [impl] DEC-02 冻结：导入只控制可见性，不产生模块限定名；模块根部导出直接
   非限定访问，namespace 成员必须用 `::` 限定访问 *)
export-decl         = 'export' , ( declaration | namespace-decl ) ; (* [impl] MOD-05/06：导出声明/整个 namespace *)
namespace-decl      = 'namespace' , qualified-name , '{' , { top-level-declaration } , '}' ;
(* [impl] PAR-22 / MOD-12 / P0-08：函数/变量成员、嵌套、限定访问与限定类型名
   （struct/class/union/enum/using）均已实现 *)

qualified-name      = identifier , { '::' , identifier } ;          (* [impl] '::' token = TOKEN_COLON_COLON *)


(* =========================================================================
   §3 声明（PAR-01 / PAR-02 / PAR-21 / GEN / INH）
   ========================================================================= *)

declaration         = [ storage-class ] , decl-core ;
storage-class       = 'extern' | 'static' | 'inline' | 'thread_local' ;   (* [impl] thread_local CON-04；块内 extern 2026-10-26 *)

decl-core           = type-alias
                    | record-decl
                    | enum-decl
                    | template-decl
                    | function-decl
                    | variable-decl-list ;

(* --- 类型别名（PAR-24：using 是唯一形式；顶层/namespace/块/聚合成员体，
   块内词法作用域，成员受访问控制；typedef/type 已移除） --- *)
type-alias          = 'using' , identifier , '=' , type-id , ';' ;  (* [impl] 上下文关键字；块/成员体见作用域规则 *)
type-id             = type , { '[' , integer-literal , ']' }
                    , [ '(' , '*' , ')' , '(' , [ parameter-list ] , ')' ]
                    | type , '(' , [ parameter-list ] , ')' ;  (* [impl] 抽象函数类型 *)
(* [impl] 2026-10-26: 固定数组维度与抽象函数指针可用于 sizeof/alignof
   以及 using 右值；`sizeof(int32[3])`、`sizeof(int32(*)(int32))`。
   [impl] SG-04/SG-05: C 风格 cast 与 type-id 使用同一递归声明符解析；
   支持 `(int32 (*)(int32))`、`int32 (*(*g)(int32))(int32)` 等嵌套形式。 *)

(* --- 记录类型（PAR-05：struct/class 共用 record 文法） --- *)
record-decl         = record-keyword , [ identifier ]
                      [ ':' , [ access-specifier ] , qualified-name ]   (* [impl] 仅记录 baseClass; 继承语义 INH-01 [plan] *)
                      [ '{' , { record-member } , '}'
                        [ record-declarator-list ] ] , ';' ;            (* [impl] 定义/前向/attached declarator *)
record-keyword      = 'struct' | 'class' ;
record-member       = access-section
                    | field-decl
                    | function-decl
                    | operator-decl
                    | type-alias
                    | record-decl
                    | union-decl
                    | enum-decl
                    | static-member-decl ;
static-member-decl  = 'static' , ( field-decl | function-decl ) ;
access-specifier    = 'public' | 'private' | 'protected' ;
access-section      = access-specifier , ':' ;  (* [plan] protected 见 PAR-04；默认级别 DEC-01 *)
(* [impl] 2026-10-26: 记录定义后可接 attached 声明符：`struct S {...} *p;`、
   `struct S {...} f();`、`struct S {...} (*fp)(int32);`。 *)
record-declarator-list = record-declarator , { ',' , record-declarator } ;
record-declarator   = member-declarator
                    | identifier , '(' , [ parameter-list ] , ')' ;
(* [impl] 2026-10-17 PAR-12: 匿名聚合定义——无 tag 的 struct/class 定义 +
   内联变量声明符（`struct { ... } v;`）。每个匿名定义是独立类型
   （合成名 __anon_N，C 语义）。 *)

union-decl          = 'union' , [ identifier ] , [ '{' , { field-decl | type-alias } , '}' ] , ';'
                    | 'union' , '{' , { field-decl | type-alias } , '}' , identifier , { ',' , identifier } , ';' ;

field-decl          = type , member-declarator , { ',' , member-declarator } , ';'
                    | bit-field-decl ;                              (* [impl] AGG-06 / PAR-10 *)
member-declarator   = [ '*' , { '*' } , [ pointer-qualifier ] ] , identifier
                      , [ '[' , const-expr , ']' ]
                    | '(' , '*' , identifier , ')' , ( '(' , [ parameter-list ] , ')' | '[' , const-expr , ']' ) ;
(* [impl] 2026-10-26: 聚合成员支持多声明符、直接函数指针字段
   `int32 (*f)(int32);` 与指向数组的指针字段 `int32 (*p)[3];`。 *)
bit-field-decl      = type , identifier , ':' , const-expr , ';' ;

(* --- 枚举（AGG-14 / TYP-09 / TYP-25） --- *)
enum-decl           = 'enum' , identifier , [ ':' , type ]
                      [ '{' , enumerator , { ',' , enumerator } , [ ',' ] , '}' ] , ';' ;
(* [impl] 底层类型 ':uint8' 等已实现（默认 i32；TYP-09/TYP-25）
   [impl] TYP-25 / AGG-14：枚举常量为编译期 int32，可参与运算与 constexpr；
          作为 switch 标签；namespace 内支持限定访问 A::Red *)
enumerator          = identifier , [ '=' , const-expr ] ;

(* --- 模板（GEN-01 / GEN-02 / PAR-21） --- *)
template-decl       = 'template' , '<' , template-parameter , { ',' , template-parameter } , '>'
                      ( function-decl | record-decl | type-alias ) ;
template-parameter  = 'typename' , identifier                           (* 类型参数 *)
                    | type , identifier ;                               (* 非类型/常量参数 *)
template-instance   = qualified-name , '<' , template-argument , { ',' , template-argument } , '>' ;
template-argument   = type | const-expr ;  (* [impl] SG-01: 常量表达式实参；模板体内依赖值表达式（`N`、`N + 1`）在实例化时替换 *)
(* [plan] 解析歧义（'<' '>' '>>'）见 GEN-04 / LEX-08 *)

(* --- 函数 --- *)
function-decl       = type , identifier , '(' , [ parameter-list ] , ')' , ( block | ';' ) ;
(* [impl] PAR-03：类外方法定义 `type Class::method(params) { ... }`——声明在
   类体内、定义在类外；签名须与类内声明一致。 *)
method-definition   = type , identifier , '::' , identifier , '(' , [ parameter-list ] , ')'
                    , ( block | ';' ) ;
(* [impl] SEM-17：运算符重载（自由函数形式）
   `type operator OP (params) { ... }`；OP ∈ + - * / % == != < > <= >= && || & | ^ << >> ~ ! ++ --
                                             | '[]' | '()' *)
operator-decl       = type , 'operator' , operator-symbol , '(' , [ parameter-list ] , ')' , block ;
operator-symbol     = '+' | '-' | '*' | '/' | '%' | '==' | '!=' | '<' | '>' | '<=' | '>='
                    | '&&' | '||' | '&' | '|' | '^' | '<<' | '>>' | '~' | '!' | '++' | '--'
                    | '[' , ']' | '(' , ')' ;
parameter-list      = parameter , { ',' , parameter } , [ ',' , '...' ] ;
parameter           = type , [ identifier ] , [ '=' , const-expr ] ;   (* [impl] 默认参数 FUN-09，仅尾随 *)
(* [impl] SG-06: 数组形参后缀接受 static/const/volatile/restrict 限定；
   例如 `int32 a[static 3]`、`const int32 a[const 3]`。 *)

(* --- 变量 --- *)
variable-decl-list  = variable-decl , { ',' , variable-decl } , ';' ;
variable-decl       = type , identifier , [ '[' , const-expr , ']' ] , [ '=' , initializer ]
                    | 'auto' , identifier , '=' , initializer ;    (* [impl] Review 2.6 仅限有初始化器的变量 *)

(* --- 函数指针 --- *)
function-pointer-type = type , '(' , '*' , identifier , ')'
                        '(' , [ type , { ',' , type } ] , ')' ;     (* [impl] 简化形式 *)


(* =========================================================================
   §4 类型（TYP / PAR-05 / PAR-06 / MEM-04/09）
   ========================================================================= *)

type                = [ 'const' | 'volatile' | 'atomic' ] , base-type
                      , [ 'const' | 'volatile' | 'atomic' ] , { pointer-suffix }
                      , [ slice-suffix | optional-suffix ] ;
(* [impl] 2026-10-26: 限定符可前置或后置——`const int32` / `int32 const`。 *)
pointer-suffix      = '*' , { 'const' | 'volatile' | 'atomic' | 'restrict' } ;
pointer-qualifier   = 'const' | 'volatile' | 'restrict' ;
(* [impl] PAR-06：`restrict` 只作为指针后缀限定符接受（`T* restrict`）；
   前导位置不作限定符解析。语义见 MEM-04。 *)
slice-suffix        = '[' , ']' ;                                   (* [impl] SliceType; 可叠加: T[][] = slice of slice *)
optional-suffix     = '?' ;                                         (* [impl] OptionalType *)

base-type           = primitive-type | named-type | record-body | enum-body
                    | template-instance ;
(* [impl] atomic 限定符 CON-01：仅整型标量；restrict/atomic 完整语义见 MEM-04 / CON-01 / DEC-11 *)

primitive-type      = 'void' | 'bool' | 'char'
                    | 'char8' | 'char16' | 'char32'                 (* [impl] TYP-05：uint8/16/32 别名 *)
                    | 'int8' | 'int16' | 'int32' | 'int64' | 'int128'
                    | 'uint8' | 'uint16' | 'uint32' | 'uint64' | 'uint128'
                    | 'isize' | 'usize'
                    | 'float16' | 'float32' | 'float64' | 'float128'
                    | 'f16' | 'f32' | 'f64' | 'f128'               (* [impl] TYP-04：短拼写 ≡ float16/32/64/128 类型关键字 *)
                    | 'string_view' | 'string' ;                   (* [impl] P1-06: identifier 特判，非关键字 *)

named-type          = qualified-name ;
record-body         = record-decl | union-decl ;                    (* 内联定义 *)
enum-body           = enum-decl ;


(* =========================================================================
   §5 语句（PAR-09；不含 goto/label，见 NG-01）
   ========================================================================= *)

block               = '{' , { statement } , '}' ;

statement           = declaration-statement
                    | expression-statement
                    | null-statement
                    | block
                    | if-statement
                    | while-statement
                    | do-while-statement
                    | for-statement
                    | switch-statement
                    | break-statement
                    | continue-statement
                    | return-statement
                    | defer-statement
                    | compile-time-if
                    | compile-time-repeat
                    | asm-statement ;                               (* [impl] asm PAR-16/CG-10 P1-08 *)

declaration-statement = declaration | type-alias ;
expression-statement  = expr , ';' ;
null-statement        = ';' ;                                    (* [impl] 2026-10-26 *)

if-statement        = 'if' , '(' , expr , ')' , statement , [ 'else' , statement ] ;
while-statement     = 'while' , '(' , expr , ')' , statement ;
do-while-statement  = 'do' , statement , 'while' , '(' , expr , ')' , ';' ;
for-statement       = 'for' , '(' , [ for-init ] , ';' , [ expr ] , ';' , [ expr ] , ')' , statement ;
for-init            = declaration-statement | expression-statement ;

switch-statement    = 'switch' , '(' , expr , ')' , '{' , { switch-item } , '}' ;
switch-item         = switch-label | statement ;                    (* 贯穿由语句顺序决定 *)
switch-label        = 'case' , const-expr , ':' | 'default' , ':' ;

break-statement     = 'break' , ';' ;
continue-statement  = 'continue' , ';' ;
return-statement    = 'return' , [ expr ] , ';' ;
defer-statement     = 'defer' , expr , ';' ;
(* [plan] defer 精确语义见 SEM-18 / FUN-10 *)

compile-time-if     = 'compile_time' , '.' , 'if' , '(' , const-expr , ')' , block , [ 'else' , block ] ;
(* [impl] CT-03 *)

compile-time-repeat = 'compile_time' , '.' , 'repeat' , '(' , const-expr , ')' , block ;
(* [impl] CTX-01/E2：sema 求值计数，codegen 展开 N 份；不生成运行时循环 *)

asm-statement       = 'asm' , [ 'volatile' ] , '(' , string-literal
                      , [ ':' , [ asm-operand-list ]
                        , [ ':' , [ asm-operand-list ]
                          , [ ':' , [ asm-clobber-list ] ] ] ] , ')' , ';' ;
asm-operand-list    = asm-operand , { ',' , asm-operand } ;
asm-operand         = [ '[' , identifier , ']' ] , string-literal , '(' , expr , ')' ;
asm-clobber-list    = string-literal , { ',' , string-literal } ;
(* [impl] asm 约束模型见 DEC-09：模板/约束透传 LLVM，方言 AD_ATT，outputs 左值回写。
   SG-19 起接受 `[name]` 命名操作数，模板 `%[name]` 按 outputs→inputs 顺序翻译为 `$N`。 *)


(* =========================================================================
   §6 表达式（PAR-08 / PAR-17/18）
   ========================================================================= *)

(* 逗号表达式为最低优先级；在实参/声明/初始化列表等位置 ',' 仅作分隔符，
   由这些产生式在调用 parseExpr 时提高 minPrec 来排除逗号。 *)
expr                = assignment-expr , { ',' , assignment-expr } ;

assignment-expr     = conditional-expr
                    | unary-expr , assign-op , assignment-expr ;    (* 右结合 *)

conditional-expr    = logical-or-expr , [ '?' , expr , ':' , assignment-expr ] ;
(* 注：条件运算符中段为完整 expr（与当前解析器一致） *)

logical-or-expr     = logical-and-expr , { '||' , logical-and-expr } ;
logical-and-expr    = bit-or-expr , { '&&' , bit-or-expr } ;
bit-or-expr         = bit-xor-expr , { '|' , bit-xor-expr } ;
bit-xor-expr        = bit-and-expr , { '^' , bit-and-expr } ;
bit-and-expr        = equality-expr , { '&' , equality-expr } ;
equality-expr       = relational-expr , { ( '==' | '!=' ) , relational-expr } ;
relational-expr     = shift-expr , { ( '<' | '>' | '<=' | '>=' ) , shift-expr } ;
shift-expr          = additive-expr , { ( '<<' | '>>' ) , additive-expr } ;
additive-expr       = multiplicative-expr , { ( '+' | '-' ) , multiplicative-expr } ;
multiplicative-expr = unary-expr , { ( '*' | '/' | '%' ) , unary-expr } ;

unary-expr          = prefix-expr
                    | postfix-expr ;
prefix-expr         = prefix-op , unary-expr
                    | 'sizeof' , unary-expr
                    | 'sizeof' , '(' , type-id , ')'                (* [impl] PAR-14：数组/函数指针 type-id *)
                    | 'alignof' , '(' , type-id , ')'               (* [impl] PAR-14 *)
                    | 'offsetof' , '(' , type , ',' , member-designator , ')'  (* [impl] PAR-14 *)
                    | cast-expr ;
prefix-op           = '+' | '-' | '!' | '~' | '*' | '&' | '++' | '--' ;
member-designator   = identifier , { '.' , identifier | '[' , const-expr , ']' } ;  (* [impl] SG-03: 下标为常量表达式 *)

cast-expr           = '(' , type , ')' , unary-expr
                    | 'static_cast' , '<' , type , '>' , '(' , assign-expr , ')'      (* [impl] PAR-18 *)
                    | 'reinterpret_cast' , '<' , type , '>' , '(' , assign-expr , ')' ; (* [impl] LEX-11 *)

postfix-expr        = primary-expr , { postfix-op } ;
postfix-op          = '[' , expr , ']'
                    | '[' , [ expr ] , ':' , [ expr ] , ']'          (* [impl] Review 2.2 范围切片 *)
                    | '(' , [ argument-list ] , ')'
                    | '.' , identifier
                    | '->' , identifier
                    | '++' | '--' ;
argument-list       = expr , { ',' , expr } ;

primary-expr        = literal
                    | 'this'                                        (* [impl] PAR-17 *)
                    | 'compile_time' , '.' , compile-time-member    (* [impl] CT-01/06/07/13 *)
                    | qualified-name
                    | '(' , expr , ')'
                    | '(' , type , ')' , initializer-list           (* [impl] PAR-08 复合字面量：块内栈对象，禁直接转义 *)
                    | initializer-list
                    | lambda-expr ;                                 (* [impl] PAR-11, 2026-10-17 *)

literal             = integer-literal | float-literal | char-literal
                    | string-literal | boolean-literal | null-literal ;

initializer-list    = '{' , [ initializer , { ',' , initializer } , [ ',' ] ] , '}' ;
initializer          = expr
                    | designated-initializer                        (* [impl] PAR-13 *)
                    | initializer-list ;
(* [impl] PAR-08：slice 变量可由初始化列表构造（`int32[] s = {1,2,3};`）——
   底层为栈上匿名数组 + {ptr,len} 视图；返回该 slice 属悬垂转义，sema 拒绝。 *)
designated-initializer = '.' , identifier , '=' , initializer ;

lambda-expr         = lambda-capture
                      '(' , [ parameter-list ] , ')'
                      [ '->' , type ] , block ;                     (* [impl] PAR-11 / DEC-10, 2026-10-17 *)
lambda-capture      = '[' [ capture-spec ] ']' ;
capture-spec        = '=' [ ',' override-list ]                      (* [impl] 默认按值 + 显式覆盖 *)
                    | '&' [ ',' override-list ]                      (* [impl] 默认按引用 + 显式覆盖 *)
                    | capture-list ;
capture-list        = capture-item , { ',' , capture-item } ;
override-list       = capture-item , { ',' , capture-item } ;
capture-item        = [ '&' ] identifier [ '=' assignment-expr ] ;
(* [impl] PAR-11 / DEC-10, 2026-11-04:
   - `[]` 无捕获；`[=]` / `[&]` 按 body 实际引用自动捕获；
   - `[=, &x]` / `[&, x]` 默认模式 + 显式覆盖（显式项优先）；
   - `[x = expr]` 按值捕获初始化，`[&x = expr]` 按引用捕获初始化；
   - `[this]` 显式捕获当前对象；`[=]` / `[&]` 在方法内使用 `this` 或裸字段时
     自动按值捕获 `this`；
   - 捕获初始化表达式用 assignment-expr，逗号只作列表分隔符。 *)


(* =========================================================================
   §7 注解（ANN-01）
   ========================================================================= *)

annotation          = '[[' , annotation-body , ']]' ;
annotation-body     = annotation-name , [ '(' , [ annotation-arg , { ',' , annotation-arg } ] , ')' ] ;
annotation-name     = identifier
                    | 'repr'                                  (* [[repr(C)]] *)
                    | 'packed' | 'align' | 'inline' | 'cold'
                    | 'nonnull' | 'deprecated' ;
annotation-arg      = const-expr | type | identifier | string-literal ;
(* [plan] 各注解语义与默认行为见 ANN-09/ANN-10；目标校验 ANN-06 *)


(* =========================================================================
   §8 编译期（CT / PAR-15；取代 type_info 与独立 static_assert，见 NG-12）
   ========================================================================= *)

static-assert       = 'compile_time' , '.' , 'static_assert'
                      '(' , const-expr , [ ',' , string-literal ] , ')' , ';' ;   (* [impl] CT-02 *)

compile-time-member = 'target' | 'build' | 'version'              (* [impl] CT-04/CT-05/CTX-01 *)
                    | 'file' | 'line' | 'column' | 'function'      (* [impl] CTX-01 *)
                    | reflection-function ;                       (* [impl] CT-06/07/13/CTX-01 *)
reflection-function = 'name_of' | 'size_of' | 'align_of' | 'bit_size_of'
                    | 'padding_of' | 'is_packed' | 'offset_of'
                    | 'fields_of' | 'attributes_of'
                    | 'type_name_of' | 'type_kind_of'
                    | 'type_of' | 'array_of' | 'pointer_to' | 'const_of'
                    | 'is_same' | 'is_integer' | 'is_float' | 'is_bool'
                    | 'is_pointer' | 'is_array' | 'is_aggregate' | 'is_class'
                    | 'is_struct' | 'is_union' | 'is_enum' | 'is_void'
                    | 'is_signed' | 'is_convertible' | 'is_assignable'
                    | 'is_base_of' | 'int_min' | 'int_max' | 'uint_max'
                    | 'bit_width' | 'float_epsilon' | 'float_max'
                    | 'float_digits' | 'layout_size_of' | 'layout_align_of'
                    | 'has_field' | 'field_count_of' | 'field_name_at'
                    | 'field_type_name_of' | 'field_size_of'
                    | 'field_offset_of' | 'field_is_bitfield'
                    | 'field_bit_width_of' | 'field_annotation_count_of'
                    | 'field_annotation_name_at' | 'field_annotation_arg_of'
                    | 'has_attribute' | 'attribute_count_of'
                    | 'attribute_name_at' | 'attribute_arg_of'
                    | 'enum_count_of' | 'enum_name_at' | 'enum_value_at'
                    | 'enum_value_of' | 'enum_name_of' | 'enum_underlying_name'
                    | 'method_count_of' | 'has_method' | 'method_name_at'
                    | 'method_param_count' | 'method_param_type_name'
                    | 'method_return_type_name' | 'base_name_of'
                    | 'template_name_of' | 'template_arg_count'
                    | 'template_arg_name'
                    | 'fail' | 'warn' | 'debug'
                    | 'assert_eq' | 'assert_ne' | 'assert_size'
                    | 'assert_align' | 'assert_offset'
                    | 'format' | 'to_string' ;


(* =========================================================================
   §9 运算符优先级 / 结合性（INF-10，与 Parser::getPrecedence 对齐）
   =========================================================================
    优先级  运算符                              结合性
   ---------------------------------------------------------------------------
      1     ,                                    左
      2     = += -= *= /= %= &= |= ^= <<= >>=    右
      3     ?:                                   右
      4     ||                                   左
      5     &&                                   左
      6     |                                    左
      7     ^                                    左
      8     &                                    左
      9     == !=                                左
     10     < > <= >=                            左
     11     << >>                                左
     12     + -                                  左
     13     * / %                                左
     14     prefix + - ! ~ * & ++ -- sizeof      右（前缀一元）
     15     postfix ++ -- () [] . ->             左
     16     primary / literal / (expr) / {}       —
   ========================================================================= *)
