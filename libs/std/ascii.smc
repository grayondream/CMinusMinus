// ===== std.ascii — ASCII classification and case conversion =====
// Import with `import std.ascii;`. Non-ASCII bytes (>= 0x80) are not letters;
// use std.string/UTF-8 helpers for Unicode text.
module std.ascii;

export namespace std {

bool is_alpha(int32 c) {
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z');
}

bool is_digit(int32 c) {
    return c >= '0' && c <= '9';
}

bool is_alnum(int32 c) {
    return is_alpha(c) || is_digit(c);
}

bool is_space(int32 c) {
    return c == ' ' || c == '\t' || c == '\n' || c == '\r' ||
           c == '\v' || c == '\f';
}

bool is_upper(int32 c) {
    return c >= 'A' && c <= 'Z';
}

bool is_lower(int32 c) {
    return c >= 'a' && c <= 'z';
}

bool is_hex_digit(int32 c) {
    return is_digit(c) || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F');
}

int32 to_lower(int32 c) {
    if (is_upper(c)) {
        return c + ('a' - 'A');
    }
    return c;
}

int32 to_upper(int32 c) {
    if (is_lower(c)) {
        return c - ('a' - 'A');
    }
    return c;
}

// Returns 0..15 or -1.
int32 to_digit(int32 c) {
    if (c >= '0' && c <= '9') return c - '0';
    if (c >= 'a' && c <= 'f') return c - 'a' + 10;
    if (c >= 'A' && c <= 'F') return c - 'A' + 10;
    return -1;
}

} // namespace std
