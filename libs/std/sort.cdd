// ===== std.sort — stable in-place sorting / search =====
// Import with `import std.sort;` and use `std::sort(...)`.
// C semantics: comparator returns <0, 0, >0; storage is not allocated.
module std.sort;

export namespace std {

// Stable insertion sort over a contiguous range.
template<typename T> void sort(T* data, usize len, int32 (*cmp)(T, T)) {
    int32 (*less)(T, T) = cmp;
    if (less == null || len < 2) {
        return;
    }
    usize i = 1;
    while (i < len) {
        T key = data[i];
        usize j = i;
        while (j > 0 && less(key, data[j - 1]) < 0) {
            data[j] = data[j - 1];
            j = j - 1;
        }
        data[j] = key;
        i = i + 1;
    }
}

template<typename T> void sort_slice(T[] data, int32 (*cmp)(T, T)) {
    sort<T>(data.data, data.len, cmp);
}

template<typename T> bool is_sorted(T* data, usize len, int32 (*cmp)(T, T)) {
    int32 (*less)(T, T) = cmp;
    if (less == null || len < 2) {
        return true;
    }
    usize i = 1;
    while (i < len) {
        if (less(data[i], data[i - 1]) < 0) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// Binary search over a sorted range. Returns the index, or -1.
template<typename T> isize binary_search(T* data, usize len, T key,
                                         int32 (*cmp)(T, T)) {
    int32 (*c)(T, T) = cmp;
    if (c == null) {
        return -1;
    }
    usize lo = 0;
    usize hi = len;
    while (lo < hi) {
        usize mid = lo + (hi - lo) / 2;
        int32 r = c(data[mid], key);
        if (r == 0) {
            return (isize)mid;
        }
        if (r < 0) {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    return -1;
}

} // namespace std
